# Intermediate renders: regenerate with tools/label_bottles.py. The inputs
# (labels/*.ai and images/WarmSpringsCellar*_*.png) are versioned instead.
images/renders/


# Secrets for the club service. .env.example is the template that is committed.
.env

# The club's own data: database, invoices, outbox.
api/var/

# Member exports and the mailing waves cut from them: names, home addresses,
# dates of birth, telephone numbers. tools/plan_invitations.py refuses to
# write inside the repository; this is in case a copy arrives another way.
*_member_export*.csv
wave-*.csv
held-back.csv

__pycache__/
*.py[cod]
.pytest_cache/

# Only ever installed to run tools/render_favicons.mjs.
node_modules/
