# Copy to .env next to docker-compose.yml. Never commit the real file.
# docker compose reads it automatically.

# Where the site answers from the outside. Offer links are built from this, so
# it has to be the address a member's browser can actually reach.
PUBLIC_BASE_URL=https://warmspringscellar.com

# Signs the invitation links. Generate ONCE and keep it:
#   openssl rand -base64 48
# Changing it invalidates every invitation already sitting in someone's inbox.
SECRET_KEY=

# The cellar desk at /admin. Restrict it by address in nginx.conf as well.
ADMIN_USER=cellar
ADMIN_PASSWORD=

# How long Charge waits behind "Tell them", in hours. Press it sooner and the
# release is refused, naming the hour it becomes possible; a single order can
# still be charged from Orders. Two reasons want the same gap: a warning that
# lands minutes before the charge is not a warning, and the notice and the
# receipt are two messages to one person, so sending both on one day doubles
# the busiest day's volume — which is what a mail provider's daily allowance
# runs out of first. A release nobody was told about is not held back.
# 0 turns it off.
RELEASE_NOTICE_GAP_HOURS=24

# Approve what the public form sends without anybody looking first, and send
# the invitation straight back. Off unless set. It does NOT loosen the checks
# that run before it — licensed states, the rate limit, the email shape and
# the duplicate check all still refuse. What it gives up is a person reading
# the application first, which can still be undone afterwards by revoking the
# offer or pausing the membership. OPERATIONS.md §3.
AUTO_APPROVE_APPLICATIONS=false

# ── Payments ────────────────────────────────────────────────────────────
# Until STRIPE_SECRET_KEY is set the service simulates the page where a card
# is saved, stores no card and charges nobody, which is how it ships so the
# flow can be walked through end to end.
#   Dashboard → Developers → API keys           (sk_live_… / sk_test_…)
#   Dashboard → Developers → Webhooks           (whsec_…)
# Point the webhook at: https://<your domain>/api/payments/webhook
# and subscribe it to: checkout.session.completed
#
# There is NO subscription and no recurring price. A member saves a card when
# they join and the club charges it when a release goes out, from the desk.
# Nothing in Stripe bills anybody on a schedule, so nothing in Stripe needs
# changing when the shipment calendar does.
#
# Stripe requires approval for alcohol sales — ask before going live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── The books: QuickBooks Online ────────────────────────────────────────
# The club posts two documents — an invoice and the payment that settles it.
# Until these are set, every invoice and payment queues up at
# /admin/accounting instead of reaching the books. Nothing is lost: the queue
# is kept and exports as CSV.
#   developer.intuit.com → My Apps → Keys & credentials
# Register this exact redirect URI on the Intuit side (must match character
# for character, and the club derives it from PUBLIC_BASE_URL):
#   https://<your domain>/admin/accounting/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# 'sandbox' for a practice company, 'production' for the real books.
QBO_ENVIRONMENT=sandbox
# Only needed if the redirect above is not what the club would derive.
QBO_REDIRECT_URI=
# QBO_WINE_ITEM must ALREADY EXIST in QuickBooks, by this name. The club will
# not create it: which income account the money lands in is the bookkeeper's
# decision, not a default worth guessing. QBO_SHIPPING_ITEM is only used when a
# tier charges for carriage as its own line, which none do today.
QBO_WINE_ITEM=Wine Club Allocation
QBO_SHIPPING_ITEM=Shipping
# Optional: the QuickBooks account id payments are deposited to. Left empty,
# QuickBooks uses the company's undeposited funds.
QBO_DEPOSIT_ACCOUNT=
# Push as each payment lands, instead of waiting for someone to press Sync.
# Leave this off for the first weeks of a new connection.
QBO_AUTOSYNC=false

# ── Mail ────────────────────────────────────────────────────────────────
# Until SMTP_HOST is set, every message is written to the data volume as a
# .eml file instead of being sent, and the approval link is shown on the desk.
#
# THE SHORT ROUTE, and what the club uses: a transactional provider outside
# Microsoft 365. The service speaks plain SMTP, so any provider that issues
# SMTP credentials drops straight in — no tenant administrator, no OAuth2.
#   SMTP_HOST=mail.smtp2go.com
#   SMTP_PORT=587
#   SMTP_USER=<an SMTP user created in the provider's dashboard, not the login>
#   SMTP_PASSWORD=<that user's password>
# Leave every SMTP_OAUTH_* empty: a token provider takes precedence over the
# password. In DNS, publish the CNAMEs the provider gives (a DKIM selector and
# a return-path) and do NOT touch the SPF record — SPF is checked against the
# provider's own return-path, not the From address, and a SECOND SPF record on
# the domain breaks every message that works today. OPERATIONS.md §8.5.
#
# THE MICROSOFT ROUTE, kept because the mailbox lives there.
# wineclub@warmspringscellar.com is a SHARED MAILBOX. A shared mailbox has no
# password and cannot sign in, so SMTP_PASSWORD has nothing to hold and basic
# authentication is not an option against it — leave it empty and fill in the
# three SMTP_OAUTH_* below instead. The tenant refuses a sign-in attempt with
# 535 5.7.3, which reads exactly like a wrong password and is not one.
# Incoming mail keeps arriving there whichever route sends.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=wineclub@warmspringscellar.com
SMTP_PASSWORD=
MAIL_FROM=wineclub@warmspringscellar.com
MAIL_REPLY_TO=wineclub@warmspringscellar.com

# Where the club writes to ITSELF: declined cards, and anything else the desk
# has to act on that no member ever sees. Empty means MAIL_REPLY_TO, which is
# already read. Point it at a person when the volume makes that worth doing.
ALERT_TO=

# ── SMTP with OAuth2 instead of a password ──────────────────────────────
# Fill these three and the service authenticates with a token rather than
# SMTP_PASSWORD. For Microsoft 365 this is the path that survives the
# retirement of basic authentication, and the only one that works once a
# tenant has turned it off.
#
# In Entra ID: register an application, give it a client secret, and grant it
# the application permission Office 365 Exchange Online → SMTP.SendAsApp with
# admin consent. Then let it send as the one mailbox, in Exchange Online
# PowerShell:
#   New-ServicePrincipal -AppId <client id> -ObjectId <object id> `
#       -DisplayName "Warm Springs Cellar - club mail"
# The ObjectId is the one on Enterprise applications, NOT the one on App
# registrations. The wrong one fails authentication in a way that looks like
# anything but a wrong id.
#
# The mailbox grant wants a THIRD id, not that ObjectId again. Read it back
# rather than pasting it:
#   $sp = Get-ServicePrincipal -Identity "Warm Springs Cellar - club mail"
#   Add-MailboxPermission -Identity wineclub@warmspringscellar.com `
#       -User $sp.Identity -AccessRights FullAccess
#
# Then enable SMTP AUTH for that mailbox. Miss this and everything above is
# correct and nothing sends, with a 535 5.7.3 that blames the credentials:
#   Set-CASMailbox -Identity wineclub@warmspringscellar.com `
#       -SmtpClientAuthenticationDisabled $false
# The per-mailbox value overrides the organisation's, so leave
# Set-TransportConfig alone — off everywhere, on for this one mailbox, is
# Microsoft's own recommendation.
#
# OPERATIONS.md §8.3 has the whole procedure, the traps and what is not
# actually documented by Microsoft (whether an unlicensed shared mailbox can
# do this at all: if it refuses with all of the above right, assign a licence).
#
# SMTP_USER stays set: the token says which app is sending, never which
# mailbox, so the mailbox has to be named too.
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
# Only for a sovereign cloud or an unusual resource; the defaults are right
# for Microsoft 365.
SMTP_OAUTH_SCOPE=https://outlook.office365.com/.default
SMTP_OAUTH_AUTHORITY=https://login.microsoftonline.com

# ── The campaign ────────────────────────────────────────────────────────
# Nothing here. The campaign is NOT sent by this service: it goes out from a
# mailing platform, which holds the list, the letter and the numbers.
# mail-templates/CAMPAIGN.md is the plan and the reasons.
#
# What stays in the club is the winery's own do-not-contact record, at
# /admin/campaigns. It needs no configuration — but it does need somebody to
# subtract it from a wave before the wave is uploaded, and to bring the
# platform's unsubscribes back across after each one.
