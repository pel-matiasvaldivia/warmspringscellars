# Copy to .env next to docker-compose.yml. Never commit the real file.
# docker compose reads it automatically.

# Where the site answers from the outside. Offer links are built from this, so
# it has to be the address a member's browser can actually reach.
PUBLIC_BASE_URL=https://warmspringscellar.com

# Signs the invitation links. Generate ONCE and keep it:
#   openssl rand -base64 48
# Changing it invalidates every invitation already sitting in someone's inbox.
SECRET_KEY=

# The cellar desk at /admin. Restrict it by address in nginx.conf as well.
ADMIN_USER=cellar
ADMIN_PASSWORD=

# ── Payments ────────────────────────────────────────────────────────────
# Until STRIPE_SECRET_KEY is set the service simulates checkout and no money
# moves, which is how it ships so the flow can be walked through end to end.
#   Dashboard → Developers → API keys           (sk_live_… / sk_test_…)
#   Dashboard → Developers → Webhooks           (whsec_…)
# Point the webhook at: https://<your domain>/api/payments/webhook
# and subscribe it to: checkout.session.completed
# Stripe requires approval for alcohol sales — ask before going live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── QuickBooks Online ───────────────────────────────────────────────────
# Until these are set, every invoice and payment queues up at
# /admin/accounting instead of reaching the books. Nothing is lost: the queue
# is kept and exports as CSV.
#   developer.intuit.com → My Apps → Keys & credentials
# Register this exact redirect URI on the Intuit side (must match character
# for character, and the club derives it from PUBLIC_BASE_URL):
#   https://<your domain>/admin/accounting/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# 'sandbox' for a practice company, 'production' for the real books.
QBO_ENVIRONMENT=sandbox
# Only needed if the redirect above is not what the club would derive.
QBO_REDIRECT_URI=
# QBO_WINE_ITEM must ALREADY EXIST in QuickBooks, by this name. The club will
# not create it: which income account the money lands in is the bookkeeper's
# decision, not a default worth guessing. QBO_SHIPPING_ITEM is only used when a
# tier charges for carriage as its own line, which none do today.
QBO_WINE_ITEM=Wine Club Allocation
QBO_SHIPPING_ITEM=Shipping
# Optional: the QuickBooks account id payments are deposited to. Left empty,
# QuickBooks uses the company's undeposited funds.
QBO_DEPOSIT_ACCOUNT=
# Push as each payment lands, instead of waiting for someone to press Sync.
# Leave this off for the first weeks of a new connection.
QBO_AUTOSYNC=false

# ── Mail ────────────────────────────────────────────────────────────────
# Until SMTP_HOST is set, every message is written to the data volume as a
# .eml file instead of being sent, and the approval link is shown on the desk.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=club@warmspringscellar.com
MAIL_REPLY_TO=club@warmspringscellar.com

# ── SMTP with OAuth2 instead of a password ──────────────────────────────
# Fill these three and the service authenticates with a token rather than
# SMTP_PASSWORD. For Microsoft 365 this is the path that survives the
# retirement of basic authentication, and the only one that works once a
# tenant has turned it off.
#
# In Entra ID: register an application, give it a client secret, and grant it
# the application permission Office 365 Exchange Online → SMTP.SendAsApp with
# admin consent. Then let it send as the one mailbox, in Exchange Online
# PowerShell:
#   New-ServicePrincipal -AppId <client id> -ServiceId <object id>
#   Add-MailboxPermission -Identity club@warmspringscellar.com `
#       -User <object id> -AccessRights FullAccess
#
# SMTP_USER stays set: the token says which app is sending, never which
# mailbox, so the mailbox has to be named too.
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
# Only for a sovereign cloud or an unusual resource; the defaults are right
# for Microsoft 365.
SMTP_OAUTH_SCOPE=https://outlook.office365.com/.default
SMTP_OAUTH_AUTHORITY=https://login.microsoftonline.com
